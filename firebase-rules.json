{
  "rules": {
    "GamificacioPDC": {
      "live": {
        "$group": {
          ".read": true,
          "$student": {
            ".write": true,
            ".validate": "newData.hasChildren(['studentId','studentName','sessionId','updatedAt'])",
            "studentId": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "studentName": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "sessionId": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "answer": { ".validate": "newData.isString() && newData.val().length <= 12000" }
          }
        }
      },
      "comments": {
        "$group": {
          ".read": true,
          "$student": {
            ".write": true,
            ".validate": "newData.hasChildren(['text','updatedAt'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 600" }
          }
        }
      }
    }
  }
}
