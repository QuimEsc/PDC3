{
  "rules": {
    ".read": false,
    ".write": false,
    "GamificacioPDC": {
      "academic": {
        "$group": {
          "events": {
            "$student": {
              ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
              "$eventId": {
                ".validate": "newData.hasChildren(['eventId','submissionId','studentId','sessionId','type','unitId','activityId','payload','status','createdAt','sequence']) && newData.child('eventId').val() === $eventId && newData.child('studentId').val() === auth.token.studentId && newData.child('sessionId').val() === auth.token.sessionId",
                ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId && !data.exists() && newData.exists() && (!newData.child('activityId').val().matches(/^u[0-9]{2}-0[5-9]$/) || (newData.child('status').val() === 'PROCESSING' && $eventId === newData.child('submissionId').val() + '-answer' && !newData.child('payload').child('grade').exists() && !newData.child('payload').child('progress').exists()))"
              }
            },
            ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
          },
          "pendingEvents": {
            "$eventId": {
              ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId)) && (auth.token.role === 'teacher' || data.child('studentId').val() === auth.token.studentId)",
              ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId && !data.exists() && newData.exists() && !newData.child('activityId').val().matches(/^u[0-9]{2}-0[5-9]$/)",
              ".validate": "newData.hasChildren(['eventId','submissionId','studentId','sessionId','type','unitId','activityId','payload','status','createdAt','sequence']) && newData.child('eventId').val() === $eventId && newData.child('studentId').val() === auth.token.studentId && newData.child('sessionId').val() === auth.token.sessionId"
            }
          },
          "backendGrades": {
            ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
            ".write": false
          },
          "unitClosures": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || auth.token.role === 'student')",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
          },
          "termClosures": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || auth.token.role === 'student')",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
          }
        }
      },
      "publicRoster": {
        "$group": {
          ".read": true,
          ".write": false,
          "students": {
            "$index": {
              ".validate": "newData.hasChildren(['id','name'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": true
          }
        }
      },
      "live": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          ".indexOn": [
            "updatedAt",
            "studentName",
            "state"
          ],
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".write": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".validate": "!newData.exists() || (newData.hasChildren(['studentId','studentName','ownerSessionId','sessionId','updatedAt']) && (auth.token.role === 'teacher' || (newData.child('studentId').val() === auth.token.studentId && newData.child('ownerSessionId').val() === auth.token.sessionId && newData.child('sessionId').val() === auth.token.sessionId)))",
            "studentId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "studentName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "ownerSessionId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "answer": {
              ".validate": "newData.isString() && newData.val().length <= 12000"
            },
            "feedback": {
              ".validate": "newData.isString() && newData.val().length <= 12000"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "presence": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          ".indexOn": [
            "updatedAt",
            "studentName",
            "state"
          ],
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId",
            ".validate": "!newData.exists() || (newData.hasChildren(['studentId','studentName','sessionId','state','updatedAt']) && newData.child('studentId').val() === auth.token.studentId && newData.child('sessionId').val() === auth.token.sessionId)",
            "studentId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "studentName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "state": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "comments": {
        "$group": {
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
            ".validate": "!newData.exists() || newData.hasChildren(['text','updatedAt'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "activityUnlocks": {
        "$group": {
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
            ".validate": "!newData.exists() || newData.hasChildren(['eventId','activityId','reason','variant','unlockedAt'])",
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "correctionApprovals": {
        "$group": {
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
            ".validate": "!newData.exists() || newData.hasChildren(['eventId','activityId','approvedAt'])",
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "participationRewards": {
        "$group": {
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
            ".validate": "!newData.exists() || newData.hasChildren(['eventId','participationCount','badgeId','updatedAt'])",
            "eventId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "participationCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "badgeId": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "unitAccess": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId))",
          ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          ".validate": "!newData.exists() || newData.hasChildren(['items','updatedAt'])"
        }
      },
      "battles": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId))",
          "current": {
            ".write": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId && data.child('participants').child(auth.token.studentKey).exists()))"
          },
          "history": {
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
          },
          "pendingFinalizations": {
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
          }
        }
      },
      "activeSessions": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'student' && auth.token.studentKey === $student && data.child('sessionId').val() === auth.token.sessionId"
          }
        }
      },
      "classState": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || auth.token.role === 'student')"
        }
      },
      "sessionRequests": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
        }
      },
      "progressEvents": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          "$student": {
            ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId",
            ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId",
            ".validate": "!newData.exists() || (newData.hasChildren(['eventId','studentId','studentName','activityId','unitId','score','status','updatedAt']) && newData.child('studentId').val() === auth.token.studentId)",
            "eventId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "studentId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "studentName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "activityId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "unitId": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": true
            }
          }
        }
      },
      "teacherState": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          "settings": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId))"
          },
          "assessmentPlan": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId))"
          },
          "unitAccess": {
            ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId))"
          },
          "studentUpdates": {
            "$student": {
              ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))"
            }
          },
          "profiles": {
            "$student": {
              ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && auth.token.studentKey === $student && root.child('GamificacioPDC').child('activeSessions').child($group).child($student).child('sessionId').val() === auth.token.sessionId))"
            }
          }
        }
      },
      "rubrics": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'",
          ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
        }
      },
      "assessmentConfig": {
        "$group": {
          ".read": "auth != null && auth.token.groupId === $group && (auth.token.role === 'teacher' || (auth.token.role === 'student' && root.child('GamificacioPDC').child('activeSessions').child($group).child(auth.token.studentKey).child('sessionId').val() === auth.token.sessionId))",
          ".write": "auth != null && auth.token.groupId === $group && auth.token.role === 'teacher'"
        }
      }
    }
  }
}
