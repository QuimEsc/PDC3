new file mode 100644
index 0000000..b8e5a81
--- /dev/null
+++ b/app/components/PendingQualificationPanel.tsx
@@ -0,0 +1,87 @@
+"use client";
+import { useEffect, useRef, useState } from "react";
+import { apiCall, firebasePath, initFirebase } from "../../lib/services";
+import { qualificationCases, qualificationLabels, type QualificationCase } from "../../lib/pending-qualification";
+
+export function PendingQualificationPanel({ refreshKey, students, onOpenActivity }: {
+  refreshKey: unknown; students: Array<{ id: string; name: string }>; onOpenActivity: (id: string) => void;
+}) {
+  const [cases, setCases] = useState<QualificationCase[]>([]);
+  const [refresh, setRefresh] = useState(0);
+  const [notice, setNotice] = useState("");
+  useEffect(() => {
+    let active = true;
+    const db = initFirebase();
+    if (!db) return;
+    void Promise.all(["events", "backendGrades", "pendingAnswerManagement"].map(path => db.ref(firebasePath("academic", path)).once("value")))
+      .then(([events, grades, management]) => { if (active) setCases(qualificationCases(events.val() || {}, grades.val() || {}, management.val() || {})); })
+      .catch(() => { if (active) setNotice("No s’ha pogut carregar la gestió de pendents. No s’ha modificat cap dada."); });
+    return () => { active = false; };
+  }, [refreshKey, refresh]);
+  return <section className="technical-incident-panel pending-qualification-panel"><header><h2>Gestió de qualificacions pendents</h2><b>{cases.length}</b></header>
+    <p>Les revisions pedagògiques revisen notes existents. Ací es gestionen enviaments sense qualificació i incidències de sincronització.</p>
+    <button type="button" onClick={() => setRefresh(n => n + 1)}>Actualitzar</button>
+    {notice && <p role="status">{notice}</p>}
+    <div className="technical-incident-list">{cases.map(item => <PendingCase key={item.event.eventId} item={item}
+      name={students.find(s => s.id === item.event.studentId)?.name || item.event.studentId} onOpenActivity={onOpenActivity}
+      onSaved={() => setRefresh(n => n + 1)} />)}</div>
+  </section>;
+}
+
+function PendingCase({ item, name, onOpenActivity, onSaved }: { item: QualificationCase; name: string; onOpenActivity: (id: string) => void; onSaved: () => void }) {
+  const inFlight = useRef(false);
+  const resolutionOperation = useRef<string | null>(null);
+  const [preview, setPreview] = useState<{ ticket: string; expectedHash: string } | null>(null);
+  const [busy, setBusy] = useState(false), [notice, setNotice] = useState("");
+  const [disposition, setDisposition] = useState("PENDING_DECISION");
+  const [confirm, setConfirm] = useState<"RECOVER" | "RESOLVE" | null>(null);
+  const event = item.event;
+  const identity = { studentId: event.studentId, activityId: event.activityId, submissionId: event.submissionId };
+  const context = event.payload.recoveryContext as { activitySnapshot?: { prompt?: string; rubric?: unknown } } | undefined;
+  async function request(action: string, payload: Record<string, unknown>) {
+    if (inFlight.current) return;
+    inFlight.current = true;
+    setBusy(true); setNotice("");
+    try {
+      const result = await apiCall(action, { ...identity, ...payload });
+      if (action === "teacher_pending_preview") { setPreview({ ticket: result.ticket, expectedHash: result.expectedHash }); setConfirm("RECOVER"); }
+      else { resolutionOperation.current = null; setConfirm(null); setPreview(null); setNotice("Operació confirmada. Els originals es conserven."); onSaved(); }
+    } catch (error) { setNotice(error instanceof Error ? error.message : "Operació aturada; cal tornar a comprovar el mateix enviament."); setConfirm(null); }
+    finally { inFlight.current = false; setBusy(false); }
+  }
+  return <article><strong>{name} · {event.activityId} · {new Date(event.createdAt).toLocaleString("ca-ES")}</strong>
+    <b>{qualificationLabels[item.state]}</b><p>{item.reason}</p>
+    <details><summary>Revisar resposta original</summary>
+      <p style={{ whiteSpace: "pre-wrap" }}>{typeof event.payload.answer === "string" ? event.payload.answer || "(Sense resposta)" : "Contingut no disponible"}</p>
+      <small>Intent {Number(event.payload.attemptsBefore || 0) + 1} · Variant {Number(event.payload.variant || 0)} · {event.submissionId}</small>
+      <p>ANSWER: conservat · GRADE: {item.hasGrade ? "existent" : "absent"} · Resultat backend: {item.hasBackend ? "existent" : "absent"}</p>
+      <p>Enunciat original: {context?.activitySnapshot?.prompt || "Context històric no disponible"}</p>
+      <pre style={{ whiteSpace: "pre-wrap" }}>{JSON.stringify(context?.activitySnapshot?.rubric || [], null, 2)}</pre>
+      <p>Enviaments posteriors: {item.later.join(", ") || "Cap"}</p>
+      <button type="button" onClick={() => onOpenActivity(event.activityId)}>Veure activitat i rúbrica actuals</button>
+      <details><summary>Historial administratiu</summary><pre style={{ whiteSpace: "pre-wrap" }}>{JSON.stringify(item.history, null, 2)}</pre></details>
+    </details>
+    <button type="button" disabled={busy || !item.canPreview} onClick={() => void request("teacher_pending_preview", {})}>Preparar recuperació individual</button>
+    {!item.canPreview && <small>Recuperació bloquejada: {item.reason}</small>}
+    <label>Resolució administrativa <select disabled={busy} value={disposition} onChange={e => { resolutionOperation.current = null; setDisposition(e.target.value); }}>
+      <option value="PENDING_DECISION">Pendent de decisió acadèmica</option><option value="SUBSTITUTED">Substituïda</option>
+      <option value="EMPTY">Buida, sense evidència qualificable</option><option value="UNRECOVERABLE">No recuperable</option>
+      <option value="TECHNICAL_RESOLVED">Incidència tècnica resolta</option>
+    </select></label>
+    <button type="button" disabled={busy} onClick={() => setConfirm("RESOLVE")}>Preparar resolució sense nota</button>
+    {confirm && <div role="dialog" aria-modal="true" aria-label="Autoritzar operació individual">
+      <p>{confirm === "RECOVER" ? "Autoritzes recuperar només este enviament original? Pot consumir una qualificació del model i la reparació prevista. No es crea un altre intent." : "Confirma esta resolució administrativa individual. No genera notes ni elimina la resposta."}</p>
+      <button type="button" disabled={busy} onClick={() => setConfirm(null)}>Cancel·lar</button>
+      <button type="button" disabled={busy} onClick={() => {
+        if (confirm === "RECOVER" && preview) void request("teacher_recover_pending", { ...preview, confirmRecovery: true });
+        else void (async () => {
+          // Hash is calculated from the original immutable record, never a caller-supplied mark.
+          const { pendingAnswerHash } = await import("../../lib/pending-qualification-hash");
+          resolutionOperation.current ||= crypto.randomUUID();
+          await request("teacher_resolve_pending", { disposition, confirmResolution: true, operationId: resolutionOperation.current, expectedHash: await pendingAnswerHash(event) });
+        })();
+      }}>Confirmar operació</button>
+    </div>}
+    {notice && <p role="status">{notice}</p>}
+  </article>;
+}
