+++ b/lib/pending-qualification.ts
@@ -0,0 +1,41 @@
+import type { AcademicEvent } from "./academic-queue";
+import { hasConfirmedGrade } from "./grade-contract";
+
+export type PendingManagement = { resolution?: { disposition: string; status: string }; history?: Record<string, unknown> };
+export type QualificationCase = {
+  event: AcademicEvent; state: string; reason: string; canPreview: boolean;
+  later: string[]; hasGrade: boolean; hasBackend: boolean; history: unknown[];
+};
+export const qualificationLabels: Record<string, string> = {
+  FIRST_GRADE_PENDING: "Pendent de primera qualificació", RECOVERABLE: "Recuperable",
+  GRADE_CONFIRMED: "Qualificació confirmada i sincronitzada",
+  SYNC_PENDING: "Qualificació existent pendent de sincronització", SUBSTITUTED: "Resposta substituïda",
+  EMPTY: "Resposta buida", DECISION_REQUIRED: "Requereix decisió docent",
+  ADMIN_RESOLVED: "Incidència resolta administrativament", UNRECOVERABLE: "No recuperable amb les evidències actuals",
+};
+
+/** Advisory classification only. Eligibility and authorisation are rechecked by the server. */
+export function qualificationCases(events: Record<string, Record<string, AcademicEvent>> = {},
+  backends: Record<string, Record<string, unknown>> = {}, management: Record<string, Record<string, PendingManagement>> = {}): QualificationCase[] {
+  return Object.entries(events).flatMap(([student, entries]) => Object.values(entries || {})
+    .filter(e => e.eventId === `${e.submissionId}-answer`).flatMap(event => {
+      const grade = entries[`${event.submissionId}-grade`];
+      const hasGrade = hasConfirmedGrade(grade?.payload.grade), hasBackend = Boolean(backends[student]?.[event.submissionId]);
+      const meta = management[student]?.[event.submissionId];
+      if (hasGrade && grade.status === "SYNCED" && !meta) return [];
+      const later = Object.values(entries).filter(e => e.activityId === event.activityId && e.submissionId !== event.submissionId && e.createdAt > event.createdAt).map(e => e.submissionId);
+      const context = event.payload.recoveryContext as { schemaVersion?: string } | undefined;
+      const declared = event.payload.answer === "" && event.payload.submissionMode === "EXPLICIT_NO_ANSWER" && event.payload.explicitConfirmation === true;
+      let state = "FIRST_GRADE_PENDING", reason = "Cal verificar el context original al servidor abans de recuperar.";
+      if (hasGrade && grade.status === "SYNCED") { state = "GRADE_CONFIRMED"; reason = "Resultat confirmat i projectat. Historial de recuperació conservat; no cal requalificar."; }
+      else if (hasGrade || hasBackend) { state = "SYNC_PENDING"; reason = "Consultar/reconciliar el resultat existent; no tornar a qualificar."; }
+      else if (later.length) { state = "SUBSTITUTED"; reason = "Hi ha un enviament posterior. No es recupera l’anterior."; }
+      else if (event.payload.answer === "" && !declared) { state = "EMPTY"; reason = "Sense declaració voluntària: no es pot convertir retroactivament en zero."; }
+      else if (typeof event.payload.answer !== "string") { state = "UNRECOVERABLE"; reason = "Falta el text original de la resposta."; }
+      else if (context?.schemaVersion !== "PDC_ANSWER_CONTEXT_V1") { state = "DECISION_REQUIRED"; reason = "Falta el context històric inequívoc. Recuperació automàtica bloquejada."; }
+      else if (declared || ["open", "decision", "mission", "text"].includes(String(event.payload.kind))) { state = "RECOVERABLE"; reason = "Candidat pendent de revalidació individual al servidor; no és una autorització."; }
+      if (meta?.resolution?.status === "RESOLVED") { state = "ADMIN_RESOLVED"; reason = `Resolució administrativa: ${meta.resolution.disposition}. No modifica la nota ni l’ANSWER.`; }
+      else if (meta?.resolution?.disposition === "PENDING_DECISION") { state = "DECISION_REQUIRED"; reason = "Decisió acadèmica pendent registrada pel docent."; }
+      return [{ event, state, reason, canPreview: state === "RECOVERABLE", later, hasGrade, hasBackend, history: Object.values(meta?.history || {}) }];
+    })).sort((a,b) => b.event.createdAt - a.event.createdAt);
+}
