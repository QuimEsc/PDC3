new file mode 100644
index 0000000..f5e5dc8
--- /dev/null
+++ b/lib/pending-qualification-hash.ts
@@ -0,0 +1,13 @@
+import type { AcademicEvent } from "./academic-queue";
+// Match the backend writer even for an incomplete legacy record with absent fields.
+function canonicalJson(value: unknown): string | undefined {
+  if (Array.isArray(value)) return "[" + value.map(canonicalJson).join(",") + "]";
+  if (value && typeof value === "object") return "{" + Object.keys(value).sort().map(k => JSON.stringify(k) + ":" + canonicalJson((value as Record<string, unknown>)[k])).join(",") + "}";
+  return JSON.stringify(value);
+}
+export async function pendingAnswerHash(event: AcademicEvent) {
+  const stable = canonicalJson({ eventId: event.eventId, submissionId: event.submissionId, studentId: event.studentId,
+    unitId: event.unitId, activityId: event.activityId, sessionId: event.sessionId, type: event.type, sequence: event.sequence, createdAt: event.createdAt, payload: event.payload });
+  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(stable)));
+  return Array.from(new Uint8Array(bytes), b => b.toString(16).padStart(2,"0")).join("");
+}
diff --git a/lib/pending-qualification.ts b/lib/pending-qualification.ts
