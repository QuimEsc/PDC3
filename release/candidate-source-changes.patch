+export function ExplicitBlankConfirmation({ busy, onCancel, onConfirm }: { busy: boolean; onCancel: () => void; onConfirm: () => void }) {
+  return <div role="dialog" aria-modal="true" aria-label="Confirmar entrega en blanc" className="explicit-blank-confirmation">
+    <p>Vols entregar aquesta activitat sense resposta? Obtindràs 0 punts i comptarà com un intent.</p>
+    <button type="button" disabled={busy} onClick={onCancel}>Cancel·lar</button>
+    <button type="button" disabled={busy} onClick={onConfirm}>Confirmar l’entrega en blanc</button>
+  </div>;
+}
