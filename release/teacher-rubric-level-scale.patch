diff --git a/tests/teacher-rubric-scale.test.mjs b/tests/teacher-rubric-scale.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..998ef29d489e42a64f161c367529ba908218ec4c
--- /dev/null
+++ b/tests/teacher-rubric-scale.test.mjs
@@ -0,0 +1,160 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { build } from "esbuild";
+import { loadWithFirebase, memoryDatabase } from "./support/firebase-memory.mjs";
+import { pendingBackend } from "./support/pending-backend.mjs";
+
+const bundle = await build({ stdin: { contents: `
+  export * from "./lib/rubrics";
+  export { curriculum } from "./lib/curriculum";
+  export { gradeLocally, gradeNumericProcedure } from "./lib/checker";
+  export * from "./lib/teacher-rubric-scale-preview";
+`, resolveDir: process.cwd() }, bundle: true, write: false, platform: "node", format: "esm" });
+const rubric = await import(`data:text/javascript;base64,${Buffer.from(bundle.outputFiles[0].text).toString("base64")}`);
+
+const descriptors = { MOLT_CONSOLIDAT: "A", CONSOLIDAT: "B", EN_PROCES: "C", INICIAL: "D", SENSE_INFORMACIO: "E" };
+const template = rubric.createRubric({
+  name: "Importació sintètica", topic: "u03", evidenceType: "ORAL_PRESENTATION",
+  rows: Array.from({ length: 5 }, (_, i) => ({ indicator: "Indicador " + i, criterion: "MAT-1.2", descriptors })),
+}, undefined, "2026-10-01", "rubric-test");
+const old = rubric.createRubricAssessment(template, "TEST", "old", "2026-10-01");
+const frozen = { ...old, assessmentId: "closed", status: "CLOSED" };
+const scores = { MOLT_CONSOLIDAT: 9.5, CONSOLIDAT: 7.25, EN_PROCES: 4, INICIAL: 0 };
+function ratingsFor(assessmentId) {
+  return Object.fromEntries(template.indicators.map(({ indicatorId }, i) => [indicatorId, {
+    assessmentId, studentId: "PUPIL", indicatorId, levelId: Object.keys(descriptors)[i], revision: 1, updatedAt: "2026-10-02",
+  }]));
+}
+
+test("all five historical level IDs retain identity and only four count", () => {
+  assert.equal(rubric.rubricScore(template.indicators, ratingsFor("old")), 5.5);
+  assert.equal(rubric.rubricScore(template.indicators, ratingsFor("closed"), scores), 5.1875);
+  assert.deepEqual(rubric.rubricEvidence(old, "PUPIL", ratingsFor("old")).map(e => e.score), [10, 7, 4, 1]);
+});
+
+test("dry-run is deterministic, preserves IDs, protects closures and does not guess a level from a number", () => {
+  const ratings = ratingsFor("old");
+  ratings[template.indicators[4].indicatorId] = { score: 7.5 };
+  const data = { catalog: { [template.rubricId]: { currentVersion: 1, versions: { 1: template } } },
+    assessments: { old, closed: frozen }, ratings: { old: { PUPIL: ratings }, closed: { PUPIL: ratingsFor("closed") } } };
+  const copy = structuredClone(data);
+  const scope = { plan: { terms: [{ term: 1, closed: false }] }, unitAccess: [] };
+  const preview = rubric.previewTeacherRubricScale(data, scores, scope);
+  assert.deepEqual(preview, rubric.previewTeacherRubricScale(data, scores, scope));
+  assert.deepEqual(data, copy);
+  assert.equal(preview.rubrics, 1);
+  assert.equal(preview.rows.find(row => row.assessmentId === "old").afterAverage, 5.1875);
+  assert.equal(preview.rows.find(row => row.assessmentId === "old").ratings.at(-1).state, "AMBIGUOUS");
+  assert.equal(preview.rows.find(row => row.assessmentId === "closed").protected, true);
+  assert.deepEqual(preview.before.map(e => e.id), preview.after.map(e => e.id));
+  assert.deepEqual(preview.after.filter(e => e.assessmentId === "closed").map(e => e.score), [10, 7.5, 5, 2.5]);
+  assert.deepEqual(preview.after.filter(e => e.assessmentId === "old").map(e => e.score), [9.5, 7.25, 4, 0]);
+  const closedTerm = rubric.previewTeacherRubricScale(data, scores, { ...scope, plan: { terms: [{ term: 1, closed: true }] } });
+  assert.deepEqual(closedTerm.after, closedTerm.before);
+});
+
+test("authenticated teacher save is validated, atomic, versioned and replayable", () => {
+  const f = pendingBackend();
+  f.ctx.console.error = () => {};
+  const call = (payload) => JSON.parse(f.ctx.doPost({ postData: { contents: JSON.stringify({ action: "teacher_save_rubric_level_scale", ...payload }) } }).text);
+  f.ctx.pdcJson_ = result => ({ text: JSON.stringify(result) });
+  const data = { teacherToken: "teacher-test", groupId: "TEST", scores, expectedRevision: 0 };
+  const path = "GamificacioPDC/rubrics/TEST/levelScale";
+  assert.equal(call({ ...data, teacherToken: "" }).ok, false);
+  assert.equal(call({ ...data, groupId: "OTHER" }).ok, false);
+  for (const bad of [{ ...scores, INICIAL: -1 }, { ...scores, INICIAL: 4 }, { ...scores, CONSOLIDAT: "7" }, { ...scores, SENSE_INFORMACIO: 0 }])
+    assert.equal(call({ ...data, scores: bad }).ok, false);
+  assert.equal(f.read(path), null);
+  const first = call(data);
+  assert.equal(first.ok, true);
+  assert.equal(first.scale.revision, 1);
+  assert.deepEqual(first.scale.scores, scores);
+  assert.deepEqual(call(data), first);
+  assert.equal(call({ ...data, scores: { ...scores, INICIAL: 1 } }).ok, false);
+  const second = call({ ...data, expectedRevision: 1, scores: { ...scores, INICIAL: 1 } });
+  assert.equal(second.scale.revision, 2);
+  assert.deepEqual(f.read(path + "/history/v1").scores, scores);
+  assert.equal(f.calls(), 0);
+});
+
+test("source mirror matches", () => {
+  assert.deepEqual(readFileSync("apps-script/Code.gs"), readFileSync("APPSCRIPT/Code.gs"));
+});
+
+test("reload reads the saved configuration and failed requests keep the previous scale and ratings", async () => {
+  const db = memoryDatabase();
+  const path = "GamificacioPDC/rubrics/TEST";
+  const f = pendingBackend();
+  f.ctx.pdcJson_ = result => ({ text: JSON.stringify(result) });
+  let offline = false;
+  const service = await loadWithFirebase("lib/rubric-service.ts", db, async (action, payload) => {
+    if (offline) throw new Error("offline");
+    const result = JSON.parse(f.ctx.doPost({ postData: { contents: JSON.stringify({
+      action, ...payload, teacherToken: "teacher-test", groupId: "TEST",
+    }) } }).text);
+    if (!result.ok) throw new Error(result.error);
+    await db.ref(path + "/levelScale").set(f.read(path + "/levelScale"));
+    return result;
+  });
+  await db.ref(path).set({ assessments: { old }, ratings: { old: { PUPIL: ratingsFor("old") } } });
+  const original = await service.readRubricData();
+  const saved = await service.saveTeacherRubricScale(scores, 0);
+  assert.deepEqual(saved.scores, scores);
+  const reloaded = await service.readRubricData();
+  assert.deepEqual(rubric.effectiveTeacherRubricScale(reloaded.levelScale), saved);
+  assert.deepEqual(reloaded.ratings, original.ratings);
+  assert.deepEqual(reloaded.assessments, original.assessments);
+  assert.deepEqual(service.rubricOperationalEvidence(reloaded), service.rubricOperationalEvidence(original));
+  offline = true;
+  await assert.rejects(service.saveTeacherRubricScale({ ...scores, INICIAL: 1 }, 1), /offline/);
+  assert.deepEqual(rubric.effectiveTeacherRubricScale((await service.readRubricData()).levelScale), saved);
+});
+
+test("curricular simulation changes only matching rubric evidence and leaves closed summaries untouched", () => {
+  const data = { catalog: {}, assessments: { old }, ratings: { old: { PUPIL: ratingsFor("old") } } };
+  const plan = rubric.previewTeacherRubricScale(data, scores, { plan: {}, unitAccess: [] });
+  const activityEvidence = { ...plan.before[0], id: "ordinary-activity", source: "PDC3", activityId: "u03-01", score: 8 };
+  const external = { ...plan.before[0], id: "unrelated-rubric", assessmentId: "unrelated-rubric", score: 8 };
+  const input = { studentId: "PUPIL", scopeId: "u03", progress: [], observations: [], attitudeWeight: 0,
+    evidenceHistory: [activityEvidence, external, ...plan.before] };
+  const original = structuredClone(input);
+  const [open, closed] = rubric.previewTeacherRubricCurricularImpact(plan, [input,
+    { ...input, unitAccess: [{ unitId: "u03", enabled: false, current: false, closed: true }] }]);
+  assert.notDeepEqual(open.before, open.after);
+  assert.deepEqual(closed.before, closed.after);
+  assert.deepEqual(input, original);
+});
+
+test("a teacher rubric scale edit leaves ordinary internal rubric, model result, deterministic grades and historical data unchanged", () => {
+  const f = pendingBackend();
+  const open = f.ctx.PDC_ACTIVITY_CATALOG["u03-05"];
+  const internalRubric = JSON.stringify(open.rubric);
+  const historical = f.answer("historical", "u03-06");
+  const historyPath = f.root + "/events/SYNTHETIC/";
+  const first = f.answer("before", "u03-05");
+  const initialGrade = f.ctx.pdcGradeOpenFirebase_(f.request("before", "u03-05")).grade;
+  const initialGradeEvent = structuredClone(f.read(historyPath + "before-grade"));
+  const numeric = rubric.curriculum.find(unit => unit.id === "u03").activities[0];
+  const choice = rubric.curriculum.find(unit => unit.id === "u03").activities[1];
+  const procedure = "m = 540 g; V = 200 cm³. d = 540/200 = 2,7 g/cm³.";
+  const deterministic = [
+    rubric.gradeNumericProcedure(numeric, "2.7", procedure),
+    rubric.gradeLocally(choice, choice.answer),
+  ];
+  // Use a fresh submission fixture for the same internal activity and answer.
+  const other = pendingBackend();
+  other.ctx.pdcSaveTeacherRubricLevelScale_({ groupId: "TEST", expectedRevision: 0, scores });
+  other.answer("after", "u03-05");
+  const laterGrade = other.ctx.pdcGradeOpenFirebase_(other.request("after", "u03-05")).grade;
+  assert.deepEqual(JSON.parse(JSON.stringify(laterGrade)), JSON.parse(JSON.stringify(initialGrade)));
